# GolfCartIQ / CartIQ — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# Production: Vercel + Supabase (https://golfcartiq.com)
# SQLite (DATABASE_URL=./data.db) is local-legacy only — not used by server/storage.ts.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Admin (REQUIRED) ────────────────────────────────────────────────────────
# Server refuses to start if unset. Send as x-admin-token header.
# Generate: python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'-_') for _ in range(48)))"
# Set in Vercel → Project Settings → Environment Variables for production.
ADMIN_PASSWORD=

# ── Supabase (REQUIRED for app + crons) ─────────────────────────────────────
# No source-code fallbacks. Missing vars must fail loudly.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Used widely in server/routes.ts and sync scripts (often same as anon, or service in ops).
SUPABASE_KEY=
# Preferred for crons/pipeline elevated writes (service_role). Never expose to the browser.
SUPABASE_SERVICE_KEY=

# ── Optional / scripts ──────────────────────────────────────────────────────
# Postgres connection string for one-off migration scripts (migrate.js / run_migration.*).
# Not read by SupabaseStorage. Prefer this over embedding passwords in source.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional for migrate.js Management/API-style DDL helpers
# SUPABASE_PROJECT_REF=
# SUPABASE_DB_PASSWORD=

# Feature flags
# DEALER_PAGES_ENABLED=1

# Set automatically on Vercel
# VERCEL=1
